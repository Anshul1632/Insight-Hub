# Copy this file to .env and adjust as needed.
# All variables are optional - sensible defaults are used if unset.

# SQLite by default. To use Postgres/MySQL in production, e.g.:
# INSIGHTHUB_DATABASE_URL=postgresql://user:password@host:5432/insighthub
INSIGHTHUB_DATABASE_URL=sqlite:///./insighthub.db

# Comma-separated list of allowed frontend origins (CORS)
INSIGHTHUB_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Max upload size in bytes (default 50 MB)
INSIGHTHUB_MAX_UPLOAD_SIZE=52428800
